# Ye file sirf REFERENCE ke liye hai — asli values Koyeb ke "Environment Variables"
# section me daalni hain, kabhi bhi is file me ya GitHub par actual values mat likhna.

# ---- Telegram / Bot ----
API_ID=
API_HASH=
BOT_TOKEN=
BOT_USERNAME=

# ---- Channels (sabme bot admin hona zaroori hai) ----
DB_CHANNEL=
POST_CHANNEL=
REQUEST_CHANNEL=
SPAM_LOG_CHANNEL=
LOG_CHANNEL=
FORCE_SUB_CHANNEL=

# ---- Owner / Security ----
OWNER_ID=

# ---- Database ----
MONGO_URI=
TOTAL_STORAGE_MB=512

# ---- TMDB (poster/genre/OTT ke liye) ----
TMDB_API_KEY=
WATCH_REGION=IN

# ---- Anti-Spam ----
MUTE_MINUTES=30

# ---- Post branding ----
POWERED_BY_TEXT=Your Channel
POWERED_BY_LINK=https://t.me/

# ---- Koyeb ----
PORT=8000
